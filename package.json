{
  "name": "momentumx-be",
  "version": "1.0.0",
  "description": "Backend service for content generation tool",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --config=jest.config.cjs",
    "vercel-build": "echo 'Using pre-built dist folder'",
    "prestart": "node scripts/check-node.cjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "predev": "node scripts/check-node.cjs",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "predev:watch": "node scripts/check-node.cjs",
    "dev:watch": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p functions/tsconfig.json --noEmit",
    "test:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:18089 jest --config=jest.config.cjs --runInBand tests/emulator",
    "test:runtime": "node --test scripts/runtime-smoke.cjs"
  },
  "author": "Mimansha",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "7.4.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "ml-kmeans": "^6.0.0",
    "nodemon": "^3.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.0",
    "jest": "^30.2.0",
    "pm2": "^5.4.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "4.23.15",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "22.x || 24.x || 26.x"
  }
}
